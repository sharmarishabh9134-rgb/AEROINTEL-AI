# Copy to .env for local development. Keep all values secret and out of source control.
APP_ENV=development
DEMO_MODE=true
DATABASE_URL=sqlite:///./aerointel_demo.db
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
JWT_SECRET_KEY=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRE_MINUTES=30
FRONTEND_URL=http://127.0.0.1:8000
PUBLIC_API_BASE_URL=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPEN_METEO_LATITUDE=28.6139
OPEN_METEO_LONGITUDE=77.2090
OPEN_METEO_LOCATION=Demo region
WEATHER_CACHE_SECONDS=600
